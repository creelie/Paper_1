/-- Octahedron vertices `0..5`,`t` and `t+3` antipodal; `H_N` adjacency `|i-j| ≡ 1 mod 3`. -/
def octCl (g h : Nat) : Bool := g == h || g % 3 != h % 3
def hCl (i j : Nat) : Bool := i == j || (if i ≤ j then j - i else i - j) % 3 == 1
def prodCl (N : Nat) (u v : Nat) : Bool := octCl (u / N) (v / N) && hCl (u % N) (v % N)
/-- A dominating sequence of length 11 in `K_{2,2,2} ⊠ H_11`,while `γ_gr(K_{2,2,2}) γ_gr(H_11) = 2·5`. -/
