/-- `GF(8)` as 3-bit integers modulo `x^3+x+1`. -/
def gf8mul (a b : Nat) : Nat := Id.run do
  let mut r := 0
  let mut x := a
  let mut y := b
  for _ in [0,1,2] do
    if y % 2 == 1 then r := r ^^^ x
    y := y / 2
    x := x * 2
    if x ≥ 8 then x := x ^^^ 11
  return r
