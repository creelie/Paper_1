/-!
Finite certificates for "Grundy Domination of Graph Products and Minimum Rank".
Core Lean 4 only; every theorem is closed by `decide`.
A matrix is a list of rows of natural numbers; `matEqMod p A B` checks entrywise
congruence modulo `p`, and an equation `M = C * R` with `C` having `r` columns
certifies `rank M ≤ r` over `F_p`.
-/
abbrev Mat := List (List Nat)

def dot (u v : List Nat) : Nat := (List.zipWith (· * ·) u v).foldl (· + ·) 0

def transpose : Mat → Mat
  | [] => []
  | r :: rs => (List.range r.length).map (fun j => (r :: rs).map (fun row => row.getD j 0))

def matMul (A B : Mat) : Mat :=
  let Bt := transpose B
  A.map (fun row => Bt.map (fun col => dot row col))

def matEqMod (p : Nat) (A B : Mat) : Bool :=
  A.length == B.length &&
  (List.zipWith (fun r s => r.length == s.length &&
     (List.zipWith (fun a b => a % p == b % p) r s).all id) A B).all id

/-- `checkSeq cl seq prev`: every pair `(v, w)` has `w ∈ cl v` and `w ∉ cl u`
for all earlier terms `u`; `cl` is a closed (or open) neighbourhood relation. -/
def checkSeq (cl : Nat → Nat → Bool) : List (Nat × Nat) → List Nat → Bool
  | [], _ => true
  | (v, w) :: rest, prev => cl v w && prev.all (fun u => !cl u w) && checkSeq cl rest (v :: prev)


