/-
  Legal sequences in Kneser graphs K(n,r), core Lean 4 only.
  A vertex of K(n,r) is an r-subset of {0,...,n-1}, encoded as a bit mask.
  `legal n r s` checks that the masks in s are distinct r-subsets and that every term
  has a footprint: a vertex in its closed neighbourhood that lies in no closed
  neighbourhood of an earlier term.
-/
set_option maxRecDepth 100000

namespace Grundy

def popcount : Nat → Nat → Nat
  | 0, _ => 0
  | k+1, m => (m % 2) + popcount k (m / 2)

def isVertex (n r v : Nat) : Bool := v < 2^n && popcount n v == r

/-- closed neighbourhood membership in K(n,r): w ∈ N[v] iff w = v or w ∩ v = ∅ -/
def inN (v w : Nat) : Bool := w == v || (v &&& w) == 0

/-- all r-subsets of {0,...,n-1} as masks -/
def verts (n r : Nat) : List Nat :=
  (List.range (2^n)).filter (fun v => popcount n v == r)

def hasFootprint (V : List Nat) (prev : List Nat) (v : Nat) : Bool :=
  V.any (fun w => inN v w && prev.all (fun u => !(inN u w)))

def legalAux (V : List Nat) : List Nat → List Nat → Bool
  | _, [] => true
  | prev, v :: rest => hasFootprint V prev v && legalAux V (v :: prev) rest

def distinct : List Nat → Bool
  | [] => true
  | v :: rest => !(rest.contains v) && distinct rest

def legal (n r : Nat) (s : List Nat) : Bool :=
  s.all (isVertex n r) && distinct s && legalAux (verts n r) [] s

