diff --git a/tests/test_grundy_revision.py b/tests/test_grundy_revision.py
new file mode 100644
index 0000000..db60402
--- /dev/null
+++ b/tests/test_grundy_revision.py
@@ -0,0 +1,30 @@
+import unittest
+from ebllm.construct.grundy_revision import exact_grundy,lower_witness,legal_feet,two_fields_audit
+from ebllm.bllm.grundy_revision import replay,LIBRARY
+from ebllm.controls import load_controls
+
+class GrundyRevision(unittest.TestCase):
+    def test_exact_small_values(self):
+        self.assertEqual([exact_grundy(n) for n in (5,6,8,19)],[3,5,6,9])
+    def test_three_residue_classes(self):
+        for n in range(6,101):
+            seq,feet=lower_witness(n)
+            self.assertTrue(legal_feet(n,seq,feet))
+    def test_boundary_is_rejected(self):
+        with self.assertRaises(ValueError):lower_witness(5)
+    def test_wrong_footprint_is_rejected(self):
+        seq,feet=lower_witness(19)
+        self.assertFalse(legal_feet(19,seq,feet[:-1]+(feet[0],)))
+    def test_two_fields_from_incidence_matrices(self):
+        r=two_fields_audit()
+        self.assertEqual(r['ordered_pairs'],82994)
+        self.assertEqual(r['ratio_lower_bounds'][13],'33/26')
+    def test_replay_does_not_claim_closure(self):
+        r=replay('target','finite','uniform')
+        self.assertEqual([x['outcome'] for x in r],['partial','partial'])
+    def test_formal_and_referee_gates_remain_open(self):
+        cs=[c for c in load_controls() if c.slug.startswith('grundy-')]
+        self.assertEqual(len(cs),2)
+        self.assertTrue(all(c.label.value=='CANDIDATE' and c.factors['formal']==0 and c.factors['human']==0 for c in cs))
+    def test_exact_support_is_recorded(self):
+        self.assertIn('exact neighbourhood support',LIBRARY[3].source)
