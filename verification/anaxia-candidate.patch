@@ -0,0 +1,40 @@
+"""Supplied hand proofs; replayed construction changes and finite checks, not autonomous discovery."""
+from .targets import Con
+from .selfmod import Change, FailLoop, RuleBook, check_log
+
+LIBRARY = (
+    Con("grundy.normalize", "grundy", "normalized-first-vertex", source="H_(3q+1) is circulant"),
+    Con("grundy.halfgraph", "grundy", "uniform-upper-bound", frozenset({"normalized-first-vertex"}), "first-edge count and cut injection"),
+    Con("grundy.lower", "grundy", "lower-witness", source="explicit sequences for every N>=6"),
+    Con("grundy.rank", "grundy", "rank-bound", source="triangular footprint minor requires exact neighbourhood support"),
+    Con("grundy.fields", "grundy", "factor-bounds", frozenset({"rank-bound"}), "binary element and ternary pair incidences"),
+    Con("grundy.diagonal", "grundy", "unbounded-ratio", frozenset({"factor-bounds"}), "five-subset diagonal independent set"),
+)
+
+
+def replay(target,old,new):
+    def attempt(target,book):
+        if book.get("representation")==old:
+            return "partial", "uniform hand argument", "Finite evidence alone does not establish the target."
+        return "partial", "release gates", "Complete hand proof supplied; formalization, full priority clearance and independent review remain pending."
+    def propose(diagnosis,ranked,book,records):
+        if book.get("representation")==old:
+            return Change("representation","representation",old,new,"use the supplied uniform proof rather than extrapolating finite checks")
+        return None
+    records=FailLoop(attempt,lambda *args:"overclaim",propose,RuleBook({"representation":old})).run(target)
+    assert not check_log({target:records})
+    return [r.as_dict() for r in records]
+
+
+def audit_construction():
+    from ..construct.grundy_revision import audit
+    from ..controls import load_controls
+    result=audit()
+    result["records"]={
+        "grundy-halfgraph":replay("All-N Grundy formula","finite enumeration","half graph"),
+        "grundy-two-fields":replay("Unbounded Grundy product ratios","diagonal set alone","two finite fields"),
+    }
+    result["controls"]={c.slug:{"label":c.label.value,"blocking":c.blocking}
+                        for c in load_controls() if c.slug in result["records"]}
+    result["provenance"]="Hand proofs supplied in this research session; finite checks and replay, not autonomous discovery."
+    return result
